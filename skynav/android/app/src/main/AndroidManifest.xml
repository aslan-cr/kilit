<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.flash" android:required="false"/>

    <application
        android:label="SkyNav"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher_snow"
        android:roundIcon="@mipmap/ic_launcher_snow">

        <!-- Ana aktivite: LAUNCHER filtresi yok; ikonlar aşağıdaki activity-alias'larla seçilir. -->
        <!-- Uyku mikseri: ekran kapalıyken de çalsın (medya oynatma ön plan servisi) -->
        <service android:name=".MixerService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme"/>
        </activity>

        <!-- Dinamik ikonlar: yalnızca biri etkin olur (MainActivity.setIcon). Varsayılan: kar kristali. -->
        <activity-alias android:name=".IconSnow" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher_snow" android:roundIcon="@mipmap/ic_launcher_snow" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconLentil" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_lentil" android:roundIcon="@mipmap/ic_launcher_lentil" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconNight" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_night" android:roundIcon="@mipmap/ic_launcher_night" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconSun" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_sun" android:roundIcon="@mipmap/ic_launcher_sun" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".IconBlizzard" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_blizzard" android:roundIcon="@mipmap/ic_launcher_blizzard" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconRain" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_rain" android:roundIcon="@mipmap/ic_launcher_rain" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconSleet" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_sleet" android:roundIcon="@mipmap/ic_launcher_sleet" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconCloudy" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_cloudy" android:roundIcon="@mipmap/ic_launcher_cloudy" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconSunHot" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_sun_hot" android:roundIcon="@mipmap/ic_launcher_sun_hot" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconSunExtreme" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_sun_extreme" android:roundIcon="@mipmap/ic_launcher_sun_extreme" android:label="SkyNav">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <receiver android:name=".SkyWeatherWidget" android:exported="true" android:label="SkyNav Hava">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sky_weather_widget_info"/>
        </receiver>
        <receiver android:name=".SkySpeedWidget" android:exported="true" android:label="SkyNav Hız &amp; Yol">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sky_speed_widget_info"/>
        </receiver>
        <receiver android:name=".SkyHourlyWidget" android:exported="true" android:label="SkyNav Saatlik">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sky_hourly_widget_info"/>
        </receiver>
        <receiver android:name=".SkyMoonWidget" android:exported="true" android:label="SkyNav Ay">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sky_moon_widget_info"/>
        </receiver>
        <receiver android:name=".SkyMiniWidget" android:exported="true" android:label="SkyNav Mini">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sky_mini_widget_info"/>
        </receiver>
        <receiver android:name=".SkySkiWidget" android:exported="true" android:label="SkyNav Kayak">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sky_ski_widget_info"/>
        </receiver>
        <receiver android:name=".SkyAirWidget" android:exported="true" android:label="SkyNav Hava Kalitesi">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sky_air_widget_info"/>
        </receiver>

        <meta-data android:name="flutterEmbedding" android:value="2"/>
    </application>
    <queries>
        <intent><action android:name="android.intent.action.PROCESS_TEXT"/><data android:mimeType="text/plain"/></intent>
    </queries>
</manifest>
